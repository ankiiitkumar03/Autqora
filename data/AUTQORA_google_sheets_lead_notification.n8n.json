      "id": "b0bdb3b5-62d8-49e7-8183-ee47e29fbf2b",
      "name": "New lead in Google Sheet",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [
        240,
