      ],
      "credentials": {
        "googleSheetsTriggerOAuth2Api": {
          "id": "REPLACE_WITH_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const emailPattern = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nreturn $input.all().map((item) => {\n  const row = item.json;\n  const email = String(row.email ?? row.Email ?? '').trim();\n  const name = String(row.name ?? row.Name ?? 'New lead').trim();\n  const company = String(row.company ?? row.Company ?? '').trim();\n  const source = String(row.source ?? row.Source ?? '').trim();\n  const details = [name, email, company && `Company: ${company}`, source && `Source: ${source}`].filter(Boolean).join('\\n');\n  return { json: { ...row, leadEmail: email, leadName: name, isValid: emailPattern.test(email), notificationSubject: `New lead: ${name}`, notificationBody: `A new lead was added to Google Sheets.\\n\\n${details}` } };\n});"
      },
      "id": "4ec7197b-a3b3-45cd-91d3-ab930e01f0f8",
      "name": "Validate lead email and format notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
