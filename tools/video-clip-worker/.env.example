# Generate a random key of at least 32 characters and put the same value in n8n's Header Auth credential.
CLIP_WORKER_API_KEY=REPLACE_WITH_A_RANDOM_32_CHARACTER_OR_LONGER_KEY
# Optional: clip folders older than this are cleaned before the next job (3600–2592000 seconds; default 604800).
CLIP_RETENTION_SECONDS=604800
# Optional: SQLite publication ledger path inside the persistent clip volume.
PUBLISH_LEDGER_PATH=/app/clips/publishing-ledger.sqlite3
